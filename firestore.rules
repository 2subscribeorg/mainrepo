rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Subscriptions - Users can only access their own
    match /subscriptions/{subscriptionId} {
      // List: each document returned must belong to the caller.
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Create: Check new document's userId
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Update: Check both old and new userId
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      
      // Delete: Check existing document's userId
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Categories - Users can only access their own
    match /categories/{categoryId} {
      // List: each document returned must belong to the caller.
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Create: Check new document's userId
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Update: Check both old and new userId
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      
      // Delete: Check existing document's userId
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Budgets - Document ID is the userId
    match /budgets/{budgetId} {
      allow read: if isAuthenticated() && 
                     request.auth.uid == budgetId;
      
      allow create: if isAuthenticated() && 
                       request.auth.uid == budgetId;
      
      allow update: if isAuthenticated() && 
                       request.auth.uid == budgetId;
      
      allow delete: if isAuthenticated() && 
                       request.auth.uid == budgetId;
    }
    
    // Transactions - Users can only access their own
    match /transactions/{transactionId} {
      // List: each document returned must belong to the caller.
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Merchant Rules - the caller's own rules plus shared global rules
    // (userId == null). The app lists both, so both must be readable; writes
    // remain restricted to documents the caller owns.
    match /merchantRules/{ruleId} {
      allow list: if isAuthenticated() &&
                     (isOwner(resource.data.userId) || resource.data.userId == null);
      allow get: if isAuthenticated() &&
                    (isOwner(resource.data.userId) || resource.data.userId == null);
      
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Subscription Feedback - Users can only access their own feedback
    match /subscription_feedback/{feedbackId} {
      // List: each document returned must belong to the caller.
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Create: Check new document's userId
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Update: Check both old and new userId
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      
      // Delete: Check existing document's userId
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Subscription Feedback (camelCase) - Users can only access their own feedback
    match /subscriptionFeedback/{feedbackId} {
      // List: each document returned must belong to the caller.
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Create: Check new document's userId
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Update: Check both old and new userId
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      
      // Delete: Check existing document's userId
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Users collection - nested subcollections
    match /users/{userId} {
      // User document itself
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Subscriptions subcollection
      match /subscriptions/{subscriptionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Renewal Warnings subcollection
      match /renewalWarnings/{warningId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Categories subcollection
      match /categories/{categoryId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Plaid access tokens - highly sensitive. Only the owner may touch them,
      // and only via the authenticated client; the backend uses the Admin SDK
      // which bypasses these rules. Never expose tokens to other users.
      match /plaidTokens/{itemId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Bank connections - Users can only access their own (top-level collection)
    match /bankConnections/{connectionId} {
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Bank accounts - Users can only access their own (top-level collection)
    match /bankAccounts/{accountId} {
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
